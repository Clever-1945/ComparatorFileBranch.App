<UserControl 
    x:Class="ComparatorFileBranch.App.Controls.ErrorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:ComparatorFileBranch.App.Controls"
    mc:Ignorable="d" 
    d:DesignHeight="450" 
    d:DesignWidth="800"
    >
    <Border 
        Background="#F08080" 
        CornerRadius="20" 
        BorderBrush="Red" 
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="30"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBox 
                Padding="10" 
                Name="TextNameException"
                IsReadOnly="True" 
                BorderThickness="0" 
                Background="#00000000" 
                TextWrapping="NoWrap" 
                AcceptsReturn="False" 
                Grid.Row="0" 
                Grid.Column="0" />

            <TextBox 
                Padding="10" 
                Name="TextNameSteck"
                IsReadOnly="True"
                BorderThickness="0" 
                Background="#00000000" 
                Grid.Row="1" 
                Grid.Column="0" 
                Grid.ColumnSpan="2"
                TextWrapping="NoWrap" 
                AcceptsReturn="False" 
                />

            <Button Content="X" Grid.Row="0" Grid.Column="1" Background="#00000000" BorderThickness="0" Click="OnClose" ></Button>
        </Grid>
    </Border>
</UserControl>
